# Copy to .env. This stack runs on a Linux Docker host.
# Use sha-<full commit> tags or image@sha256:<digest> to pin deployments.
SHADNET_IMAGE=ghcr.io/kriscris/shadnet:bloodborne-coop
# Optional private frontend; requires GHCR login when enabling profile web.
SHADNET_WEB_IMAGE=ghcr.io/kriscris/shadnet-web:main

# ------------------------------------------------------------- API keys

# REQUIRED. The website authenticates to the server with these, so both
# containers have to be given the same value. Generate each with:
#
#     openssl rand -hex 32
#
# Both APIs bind 127.0.0.1, so on a host with no other users these are
# defence in depth rather than your only guard. Set them anyway: shadNet
# generates its own key when this is blank, and then only the server knows it
# and every call from the website fails with 401.
MEMBER_API_KEY=
ADMIN_API_KEY=

MEMBER_API_PORT=31360
ADMIN_API_PORT=31350

# Set to empty to run a members-only site: registration, sign-in and password
# changes, with no admin pages served at all.
#   ADMIN_API_URL=

# Which hops may name the real client via X-Forwarded-For. "local" means
# loopback plus the private ranges, which covers the web frontend. Without
# this the server counts every failed login against the website's own address,
# so eight wrong passwords from anyone would lock out everyone for 15 minutes.
SHADNET_API_TRUSTED_PROXIES=local

# ------------------------------------------------------- shadNet server

# Only applied when generating shadnet.cfg on the FIRST run. Afterwards edit
# the file inside the volume; restarts will not overwrite it.
#
# With host networking these are bound directly on the machine, so they are
# also the ports to forward on your router.
SHADNET_BIND_HOST=0.0.0.0
SHADNET_TCP_PORT=31313
SHADNET_WEBAPI_PORT=31315
SHADNET_STATS_ENABLED=false
SHADNET_MATCHING2_ENABLED=true

# Traditional co-op = false. Seamless = true. Must match the client build.
SHADNET_SEAMLESS_COOP=false

# Diagnostic. Set to 1 to log the raw JSON of every summon advertise and
# search, which is how you find out why two players cannot see each other's
# signs -- it shows every field the matcher compares. Verbose; leave empty
# for normal play.
SHADNET_BLOODBORNE_RE_TRACE=

# Comma-separated. On this fork (upstream-based) it WORKS: the admin API
# promotes every listed account at each startup, so this is the easiest way to
# grant yourself the admin pages. The account has to exist first -- register
# it, then restart the server.
SHADNET_ADMINS_LIST=

# Required to register. Leave empty to allow open registration.
SHADNET_REGISTRATION_KEY=

# ------------------------------------------------------- web frontend

# THIS decides who can load the website. There is no port mapping in front of
# it -- it is the address the site actually binds:
#   127.0.0.1   this machine only (default)
#   100.x.y.z   your Tailscale address
#   0.0.0.0     every interface -- required if you forward a port to this box
#
# Note the site speaks plain HTTP. On 0.0.0.0 with a forwarded port, sign-in
# passwords cross the internet in the clear; put a TLS reverse proxy in front
# and set WEB_BEHIND_PROXY=true if that matters to you.
#
# Host networking also means WEB_PORT has to be free on the machine itself.
WEB_BIND_HOST=127.0.0.1
WEB_PORT=8080
WEB_SITE_NAME=shadNet
WEB_ADMIN_CONTACT=

# The address players type into the emulator, shown on the landing page.
# Leave it EMPTY unless the game server is somewhere the website is not: the
# site then shows whichever hostname the visitor loaded it on, which is right
# by construction and cannot go stale when a dynamic IP changes under you.
SHADNET_PUBLIC_HOST=

# Empty: visitors must type the invite key on the registration form.
# Set: the site supplies it, so anyone who can load the page can register.
WEB_REGISTRATION_KEY=

WEB_REGISTRATION_ENABLED=true
WEB_MIN_PASSWORD_LENGTH=8

# Only true if a reverse proxy in front sets X-Forwarded-For. Trusting it
# otherwise lets anyone spoof past the rate limiter.
WEB_BEHIND_PROXY=false

# How long (ms) to hold a summon advertisement's create request open waiting for
# a summon. Delivers the claim in milliseconds instead of up to 60 seconds,
# which is what lets the summoned player reach the room before the host gives
# up. 0 disables it.
SHADNET_BLOODBORNE_CLAIM_HOLD_MS=20000

# ---------------------------------------------------------------------------
# ICE: how two players' machines find a path to each other
# ---------------------------------------------------------------------------
# Players connect directly to each other, not through this server. To do that
# each side has to learn what address the other is reachable at, which is what
# these settings are for. All of them are optional: with everything below
# empty, peers still connect whenever a direct path already exists -- on a LAN,
# or between two hosts that both have working IPv6, which is most of the time.
#
# STUN tells a player what address the outside world sees them at. It is cheap
# (one UDP round trip, no traffic afterwards) and there is no reason not to
# set it. A public server works; so does a coturn you run yourself.
SHADNET_ICE_STUN_HOST=
SHADNET_ICE_STUN_PORT=31478

# TURN relays the actual game traffic when no direct path can be found -- two
# players behind carrier-grade NAT, typically. Unlike STUN this costs real
# bandwidth, all of it yours, for as long as the session lasts.
#
# Leave these empty to run without a relay. To enable one, fill in all three,
# read docs/turn-deployment.md in the server repo (the relay port range has
# to be forwarded too, not just this one), and start the stack with:
#
#     docker compose --profile turn up -d
#
# SHADNET_ICE_TURN_HOST is what players are told to contact -- a hostname or
# public address, never a LAN address.
SHADNET_ICE_TURN_HOST=
SHADNET_ICE_TURN_PORT=31478

# Shared between shadNet and coturn and nothing else. shadNet derives a
# short-lived per-player credential from it; the relay verifies that
# credential without ever being told who the player is. Never returned by any
# API, never logged.
#
# Generate with: openssl rand -hex 32
# NEVER commit the real value. This file is an example; .env is not tracked.
SHADNET_ICE_TURN_SECRET=

# How long a credential handed to a player stays valid. An hour outlasts any
# single session while keeping a leaked credential short-lived.
SHADNET_ICE_TURN_TTL_SECONDS=3600

# The public address coturn advertises for its relayed candidates. coturn
# cannot work this out for itself when it sits behind a home router: it would
# hand out the LAN address it sees, which no internet peer can reach.
#
# Either a literal IP or a hostname. A hostname is the answer on a dynamic
# address: it is resolved at start-up, and re-checked while running (see
# below), so a changing address needs no edit here. A DDNS name works.
SHADNET_TURN_EXTERNAL_IP=

# Which record to use when the value above is a hostname: ipv4 or ipv6.
#
# ipv4 is the default on purpose. external-ip exists only to work around NAT,
# and IPv6 generally has none -- a host with a global IPv6 address is already
# advertising the right thing, and overriding it makes matters worse. Two more
# reasons to leave this alone: a DDNS name's AAAA often belongs to the router
# rather than to the machine coturn runs on, and an external-ip of a family
# coturn does not listen on describes a socket that does not exist.
SHADNET_TURN_EXTERNAL_FAMILY=ipv4

# How often to re-resolve that hostname, in seconds. 0 turns it off.
#
# coturn reads external-ip once, at start-up, so a changed address means a
# restart. When the name starts resolving to something else the container ends
# itself and the restart policy brings it back with the new value. Relayed
# sessions do not survive a public address change anyway.
SHADNET_TURN_EXTERNAL_RECHECK_SECONDS=300

# Which of this machine's addresses coturn should use, space separated. Leave
# empty on a machine with one interface. Set it on a machine that runs other
# containers: host networking exposes every Docker bridge, and coturn will
# otherwise offer relay addresses on networks no player can reach.
#
# Unlike the public address above, a LAN address does not change, so this is
# safe to pin.
SHADNET_TURN_LISTEN_IP=

# coturn image tag. Pinned so an image refresh cannot change relay behaviour
# underneath a working deployment.
COTURN_TAG=4.6
